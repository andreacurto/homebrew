{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/session-fetch.sh\"",
            "statusMessage": "Fetch della repo online..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/check-release-tag.sh\"",
            "if": "Bash(git tag *)"
          }
        ]
      }
    ]
  }
}
